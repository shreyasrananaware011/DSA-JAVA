class Solution {
    public int countStudents(int[] students, int[] sandwiches) {
        int[] a = {0, 0};

        for (int i = 0; i < students.length; i++) {
            a[students[i]]++;
        }

        int k = 0;

        while (k < sandwiches.length) {
            if (a[sandwiches[k]] > 0) {
                a[sandwiches[k]]--;
            } else {
                break;
            }
            k++;
        }

        return a[0] + a[1];
    }
}
